{
  "manifest_version": 3,
  "name": "Liquid Newtab",
  "version": "2.0.2",
  "minimum_chrome_version": "116",
  "description": "A clean and elegant customizable new tab page.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "search",
    "favicon"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
